# Copy to .env (scripts/setup.sh does this for you) and adjust.

# AdGuard Home admin login - the one you create in its setup wizard at http://<host>:3000.
# The gateway uses it to switch DNS upstreams with the exit mode (Tor mode resolves through Tor).
ADGUARD_USER=admin
ADGUARD_PASSWORD=change-me

# Address your devices connect to. Leave empty to use the host's LAN IP.
# Set a DynDNS name here (and forward UDP WG_PORT on your router) to use the VPN away from home.
PUBLIC_ENDPOINT=

# WireGuard server port and the private network your devices get addresses from.
WG_PORT=51820
VPN_SUBNET=10.13.13.0/24

# Optional second exit through any WireGuard VPN provider: save the provider's WireGuard
# config as data/gateway/provider.conf and give it a display name here.
PROVIDER_NAME=Proton

# Exit used on first start: warp | provider | tor
DEFAULT_MODE=warp

# Port of the live dashboard
DASHBOARD_PORT=80

# Who may add/remove devices and change per-device exits from the dashboard. Empty = any device
# connected through the VPN. Recommended: just your own computer, e.g. ADMIN_IPS=10.13.13.2
ADMIN_IPS=

# If the provider tunnel goes down, temporarily send its devices out through WARP instead of
# blocking them (less private, but no outage). off = stay blocked until the provider is back.
EXIT_FAILOVER=off

# Push alerts when something breaks or recovers (ntfy app on your phone). Use a long random topic,
# e.g. https://ntfy.sh/pgw-<20 random letters>, or your own ntfy server. Empty = off.
NTFY_URL=

# Electricity price for the dashboard's cost estimate (each viewer can change it in the page)
PRICE_PER_KWH=0.30
CURRENCY=€

# Away from home: install Tailscale on the host (tailscale up --advertise-exit-node --netfilter-mode=off),
# approve it as an exit node in the Tailscale admin console, then set this to "on". Your phone, using this
# gateway as its Tailscale exit node, then gets the same exit, kill switch and filtering anywhere.
TAILSCALE_EXIT=off

# Threat protection. THREAT_LISTS: block devices from reaching known-malicious addresses (Spamhaus DROP,
# abuse.ch Feodo, Emerging Threats; refreshed daily). Light, on by default.
THREAT_LISTS=on
# IDS: inspect every device's traffic with Suricata (Emerging Threats Open rules, updated daily): live
# connections and threat alerts in the dashboard, high-severity hits blocked for 24 h. Fail-open: if it
# stops, traffic passes uninspected instead of stalling. Needs ~1.5 GB RAM (a 4 GB+ Raspberry Pi).
IDS=off

# --- Anonymity ---------------------------------------------------------------
# Query-log retention in AdGuard: normal (90 days) | minimal (1 day, default) | none.
# "none" disables the stored query log (and the live DNS card + the leak test's DNS check).
LOG_MODE=minimal

# Publish a READ-ONLY copy of the dashboard as a Tor onion service: reachable from anywhere
# without opening a port on your router. Visitors can look, not switch exits or manage devices.
# The address appears on the Security page once Tor has published it.
ONION_DASHBOARD=off
ONION_READONLY_PORT=8081
