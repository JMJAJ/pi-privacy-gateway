#!/usr/bin/env python3
"""Builds /run/pgw/ids/pgw.yaml from Debian's default suricata.yaml: inline (NFQUEUE, fail-open)
inspection of VPN devices' traffic, events to the pgw-idsd watcher over a unix socket (no disk writes)."""
import os
import re

import yaml

RULES = '/config/ids/suricata/rules'
src = open('/etc/suricata/suricata.yaml').read()
src = re.sub(r'^%YAML.*\n', '', src)
c = yaml.safe_load(src)

vpn = os.environ.get('VPN_SUBNET', '10.13.13.0/24')
c['vars']['address-groups']['HOME_NET'] = f'[{vpn},100.64.0.0/10,192.168.0.0/16,172.16.0.0/12,10.0.0.0/8]'
c['vars']['address-groups']['EXTERNAL_NET'] = '!$HOME_NET'
c['default-rule-path'] = RULES
c['rule-files'] = ['suricata.rules', '/opt/pgw/ids/pgw-local.rules']
c['classification-file'] = RULES + '/classification.config'
c['reference-config-file'] = '/etc/suricata/reference.config'

# events: one unix datagram socket to the watcher; nothing written to disk
c['outputs'] = [
    {'eve-log': {'enabled': 'yes', 'filetype': 'unix_dgram', 'filename': '/run/pgw/ids/eve.sock',
                 'types': [{'alert': {'tagged-packets': 'no'}},
                           {'dns': {'enabled': 'yes', 'requests': 'yes', 'responses': 'no'}},
                           {'tls': {'extended': 'yes'}},
                           {'http': {'extended': 'no'}},
                           {'flow': None}]}},
]
c['logging'] = {'default-log-level': 'notice',
                'outputs': [{'console': {'enabled': 'yes'}},
                            {'file': {'enabled': 'no'}},
                            {'syslog': {'enabled': 'no'}}]}
# inline: repeat mode re-injects each packet into the same chain with a mark, so the gateway's own
# mangle rules (TTL masking, MSS clamping) still run after inspection; fail-open if overloaded
c['nfq'] = {'mode': 'repeat', 'repeat-mark': 0x20000000, 'repeat-mask': 0x20000000,
            'fail-open': 'yes'}
c['unix-command'] = {'enabled': 'yes', 'filename': '/run/pgw/ids/command.socket'}
c['detect']['profile'] = 'low'          # ~40% less memory on a Pi
c['stats'] = {'enabled': 'no'}
c.pop('af-packet', None)

os.makedirs('/run/pgw/ids', exist_ok=True)
with open('/run/pgw/ids/pgw.yaml', 'w') as f:
    f.write('%YAML 1.1\n---\n# generated by pgw-ids-config - edit that, not this\n')
    yaml.safe_dump(c, f, default_flow_style=False, sort_keys=False)
print('wrote /run/pgw/ids/pgw.yaml')
