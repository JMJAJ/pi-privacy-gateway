#!/bin/bash
# pgw-exit - where VPN device traffic (wg1) leaves the gateway, plus an always-on kill switch.
#   pgw-exit status                         print the default mode
#   pgw-exit set warp|provider|tor          switch the default mode for all devices (persists)
#   pgw-exit device <vpn-ip> warp|provider|tor|default   per-device override (persists)
#   pgw-exit devices                        list per-device overrides
#   pgw-exit apply                          re-apply everything
#   pgw-exit firewall                       (re)arm the kill switch only (no waiting for tunnels)
#   pgw-exit tor-via warp|provider|status   how Tor itself reaches the internet: straight into WARP, or
#                                           through the provider (inside WARP) = "Provider+Tor"
#   pgw-exit tor-bridge snowflake|off|status   reach Tor through a Snowflake bridge (hides Tor use)
#
# Optional TAILSCALE_EXIT=on: devices away from home that use this host as their Tailscale exit node
# get the same exit, kill switch, TTL masking and Tor redirect as WireGuard devices.
#
# warp:     -> Cloudflare WARP (wg0). Anything else is rejected.
# provider: -> your WireGuard VPN provider (wg2), which itself runs inside WARP.
# tor:      all TCP -> Tor's transparent proxy; DNS -> AdGuard -> Tor. Nothing else is forwarded
#           (UDP/QUIC/ICMP can't bypass Tor; browsers fall back to TCP).
#
# Optional EXIT_FAILOVER=warp: while the provider tunnel is down, devices that use it fall back to
# WARP instead of losing internet (reconcile loop decides; it writes /run/pgw/failover).
set -u
. /usr/local/bin/pgw-lib
MODE_FILE="$CFG/mode"
DEV_FILE="$CFG/device-modes"          # lines: "<vpn-ip> <mode>"
TORVIA_FILE="$CFG/tor-via"            # "provider" = Tor runs through the provider tunnel
ADGUARD_URL="${ADGUARD_URL:-http://127.0.0.1:3000}"
TOR_TRANS=9040
TOR_DNS=127.0.0.1:9053
# One resolver party per path: fewer companies see the names. The fallback is only used when
# the primary is unreachable, so in normal operation exactly one party (plus WARP underneath) sees DNS.
WARP_UPSTREAMS='["https://dns.quad9.net/dns-query"]'
WARP_FALLBACK='["https://dns.mullvad.net/dns-query"]'
# provider mode: no Cloudflare resolver (Cloudflare already knows your IP through WARP), and the
# gateway's own DNS-over-HTTPS connections to these resolvers ride the provider tunnel
PROVIDER_UPSTREAMS='["https://dns.mullvad.net/dns-query"]'
PROVIDER_FALLBACK='["https://dns.quad9.net/dns-query"]'
DOH_IPS="9.9.9.9 149.112.112.112 194.242.2.2"
# Blocking public DNS-over-HTTPS endpoints is opt-in: a browser set to "max protection"
# secure DNS does NOT fall back when its DoH endpoint is unreachable, so on by default it
# would look like "no internet". Off by default; turn on when devices do not use DoH.
DOH_BLOCK="${DOH_BLOCK:-off}"
BRIDGE_FILE="$CFG/tor-bridge"
TS_IF=tailscale0 TS_NET=100.64.0.0/10 TS_TABLE=52
ts_on() { [ "${TAILSCALE_EXIT:-off}" = on ]; }

tor_via() { [ "$(cat "$TORVIA_FILE" 2>/dev/null)" = provider ] && [ -f "$WG/wg2.conf" ] && echo provider || echo warp; }

valid_mode() { case "$1" in warp|provider|tor) return 0 ;; *) return 1 ;; esac; }
saved_mode() { local m; m=$(cat "$MODE_FILE" 2>/dev/null); valid_mode "$m" && echo "$m" || echo warp; }
overrides()  { [ -f "$DEV_FILE" ] && awk 'NF==2 && $1 ~ /^[0-9.]+$/ {print $1, $2}' "$DEV_FILE"; }
# provider -> warp while EXIT_FAILOVER is active and the provider tunnel is down
effective()  { if [ "$1" = provider ] && [ -f /run/pgw/failover ]; then echo warp; else echo "$1"; fi; }
uses() {     # is exit $1 actually in use right now (default or any device, after failover)?
  local ip m
  [ "$(effective "$(saved_mode)")" = "$1" ] && return 0
  while read -r ip m; do [ -n "$ip" ] && [ "$(effective "$m")" = "$1" ] && return 0; done < <(overrides)
  return 1
}
configured() { # does anything ask for exit $1 (before failover)?
  [ "$(saved_mode)" = "$1" ] || overrides | awk -v m="$1" '$2==m{f=1} END{exit !f}'
}

firewall() {
  # one rebuild at a time (reconcile loop vs. a manual switch); never held while waiting for tunnels
  mkdir -p /run/pgw; exec 9>/run/pgw/firewall.lock; flock -w 15 9
  _firewall "$(effective "$(saved_mode)")"
  exec 9>&-
}

# rules for one traffic class: $1 = mode, $2 = extra match ("-s <ip>" for one device, "" for the rest),
# $3 = client interface (wg1, or tailscale0 for devices away from home)
_mode_rules() {
  local mode=$1 m=$2 i=${3:-wg1} own=$VPN_IP
  [ "$i" = "$TS_IF" ] && own=$TS_NET
  case "$mode" in
    tor)
      # shellcheck disable=SC2086
      iptables -t nat -A PIX_NAT -i "$i" $m -p tcp ! -d "$own" -j REDIRECT --to-ports $TOR_TRANS ;;
    provider)
      # shellcheck disable=SC2086
      iptables -A PIX_FWD -i "$i" $m -o wg2 -j ACCEPT ;;
    *)
      # shellcheck disable=SC2086
      iptables -A PIX_FWD -i "$i" $m -o wg0 -j ACCEPT ;;
  esac
  # kill switch for this class: anything not allowed above never reaches the LAN/ISP
  # shellcheck disable=SC2086
  iptables -A PIX_FWD -i "$i" $m -p tcp -j REJECT --reject-with tcp-reset
  # shellcheck disable=SC2086
  iptables -A PIX_FWD -i "$i" $m -j REJECT
}

_firewall() {
  local default=$1 ip mode
  # dedicated chains, inserted first: never touches ufw/docker rules
  iptables -N PIX_FWD 2>/dev/null || iptables -F PIX_FWD
  iptables -C FORWARD -j PIX_FWD 2>/dev/null || iptables -I FORWARD 1 -j PIX_FWD
  iptables -t nat -N PIX_NAT 2>/dev/null || iptables -t nat -F PIX_NAT
  iptables -t nat -C PREROUTING -j PIX_NAT 2>/dev/null || iptables -t nat -I PREROUTING 1 -j PIX_NAT
  ip6tables -N PIX_FWD 2>/dev/null || ip6tables -F PIX_FWD
  ip6tables -C FORWARD -j PIX_FWD 2>/dev/null || ip6tables -I FORWARD 1 -j PIX_FWD
  ip6tables -A PIX_FWD -i wg1 -j REJECT
  ts_on && ip6tables -A PIX_FWD -i $TS_IF -j REJECT

  # anti-fingerprinting: every device's packets leave with TTL 64, so sites can't tell
  # Windows (128) from Android/iOS/Linux (64) by the TTL that arrives
  iptables -t mangle -N PIX_MANGLE 2>/dev/null || iptables -t mangle -F PIX_MANGLE
  iptables -t mangle -C FORWARD -j PIX_MANGLE 2>/dev/null || iptables -t mangle -I FORWARD 1 -j PIX_MANGLE
  iptables -t mangle -A PIX_MANGLE -i wg1 -j TTL --ttl-set 64 2>/dev/null || true
  ts_on && { iptables -t mangle -A PIX_MANGLE -i $TS_IF -j TTL --ttl-set 64 2>/dev/null || true; }

  # ---- anonymity shield ------------------------------------------------------
  # 1. DNS clamp: every lookup from a device (UDP *and* TCP) is rewritten to AdGuard,
  #    whatever server the app asked for. A hardcoded 8.8.8.8, a browser's own DoH or
  #    Android "Private DNS" can no longer resolve around the filter or outside the tunnel.
  local ifaces=(wg1) i
  ts_on && ifaces+=("$TS_IF")
  for i in "${ifaces[@]}"; do
    iptables -t nat -A PIX_NAT -i "$i" -p udp --dport 53 -j REDIRECT --to-ports 53
    iptables -t nat -A PIX_NAT -i "$i" -p tcp --dport 53 -j REDIRECT --to-ports 53

    # 2. DNS-over-TLS / DNS-over-QUIC: refuse instantly so the app falls back to the
    #    clamped plain DNS instead of resolving past the filter.
    iptables -A PIX_FWD -i "$i" -p tcp --dport 853 -j REJECT --reject-with tcp-reset
    iptables -A PIX_FWD -i "$i" -p udp --dport 853 -j REJECT

    # 4. TCP timestamps leak the sender's uptime and clock; strip the option so a site
    #    sees a generic stack (TTL 64 above and MSS clamping complete the picture).
    iptables -t mangle -A PIX_MANGLE -i "$i" -p tcp -j TCPOPTSTRIP --strip-options timestamp 2>/dev/null \
      || log "TCPOPTSTRIP unavailable: TCP timestamps not masked"

    # 5. ICMP timestamp queries leak the clock; multicast/broadcast (mDNS, SSDP,
    #    NetBIOS) has no business leaving the tunnel.
    iptables -A PIX_FWD -i "$i" -p icmp --icmp-type timestamp-request -j DROP
    iptables -A PIX_FWD -i "$i" -d 224.0.0.0/4 -j DROP
    iptables -A PIX_FWD -i "$i" -d 255.255.255.255 -j DROP
  done

  # 3. DNS-over-HTTPS to the big public resolvers: no website lives at these addresses,
  #    so a browser's built-in DoH cannot bypass AdGuard. (The dashboard's own checks run
  #    from the gateway itself, not through PIX_FWD, so they are unaffected.)
  if [ "$DOH_BLOCK" = on ] && ipset -exist create pgw-doh hash:net family inet 2>/dev/null; then
    for n in 1.1.1.0/24 8.8.8.0/24 8.8.4.0/24 9.9.9.0/24 149.112.112.0/24 \
             94.140.14.0/24 94.140.15.0/24 208.67.222.0/24 208.67.220.0/24 \
             194.242.2.0/24 45.90.28.0/24 45.90.30.0/24 76.76.2.0/24 76.76.10.0/24; do
      ipset -exist add pgw-doh "$n" 2>/dev/null || true
    done
    for i in "${ifaces[@]}"; do
      iptables -A PIX_FWD -i "$i" -p tcp --dport 443 -m set --match-set pgw-doh dst -j REJECT --reject-with tcp-reset
      iptables -A PIX_FWD -i "$i" -p udp --dport 443 -m set --match-set pgw-doh dst -j REJECT
    done
  fi

  # threat protection: devices can't reach known-malicious addresses (pgw-bad, refreshed daily by
  # pgw-threatlists) or ones the IDS caught acting badly (pgw-dyn, blocked for 24 h).
  # Needs the host's ip_set modules (scripts/setup.sh loads them); skipped if they're missing.
  if [ "${THREAT_LISTS:-on}" = on ] && ipset -exist create pgw-bad hash:net family inet maxelem 262144 2>/dev/null \
     && ipset -exist create pgw-dyn hash:ip family inet timeout 86400 2>/dev/null; then
    iptables -N PGW_THREAT 2>/dev/null || iptables -F PGW_THREAT
    iptables -A PGW_THREAT -m limit --limit 30/min -j LOG --log-prefix "PGW-THREAT " --log-level 4 2>/dev/null || true
    iptables -A PGW_THREAT -p tcp -j REJECT --reject-with tcp-reset
    iptables -A PGW_THREAT -j REJECT
    for i in wg1 $(ts_on && echo $TS_IF); do
      iptables -A PIX_FWD -i "$i" -m set --match-set pgw-bad dst -j PGW_THREAT
      iptables -A PIX_FWD -i "$i" -m set --match-set pgw-dyn dst -j PGW_THREAT
    done
  fi

  # what VPN devices may reach on the gateway itself (works even if the host runs ufw/firewalld)
  iptables -N PIX_IN 2>/dev/null || iptables -F PIX_IN
  iptables -C INPUT -j PIX_IN 2>/dev/null || iptables -I INPUT 1 -j PIX_IN
  iptables -A PIX_IN -p udp --dport "$WG_PORT" -j ACCEPT
  iptables -A PIX_IN -i wg1 -p udp --dport 53 -j ACCEPT
  iptables -A PIX_IN -i wg1 -p tcp -m multiport --dports 53,"${DASHBOARD_PORT:-80}" -j ACCEPT
  iptables -A PIX_IN -i wg1 -p tcp --dport $TOR_TRANS -j ACCEPT
  # Android "Private DNS: Automatic" probes DNS-over-TLS first; refuse it instantly instead of
  # letting it hang ~20 s before falling back to normal DNS (made pages stall on phones)
  iptables -A PIX_IN -i wg1 -p tcp --dport 853 -j REJECT --reject-with tcp-reset
  iptables -A PIX_IN -i wg1 -p icmp -j ACCEPT
  if ts_on; then   # your own Tailscale devices: DNS, dashboard, Tor's transparent port
    iptables -A PIX_IN -i $TS_IF -p udp --dport 53 -j ACCEPT
    iptables -A PIX_IN -i $TS_IF -p tcp -m multiport --dports 53,"${DASHBOARD_PORT:-80}",$TOR_TRANS -j ACCEPT
  fi

  # replies back to devices (ACCEPT, not RETURN: hosts running Docker default FORWARD to DROP)
  iptables -A PIX_FWD -o wg1 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  ts_on && iptables -A PIX_FWD -o $TS_IF -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

  # Tailscale clients: replies go back into Tailscale (before WARP's catch-all rule 99) and their
  # traffic leaves with the gateway's tunnel address
  ip rule del priority 97 2>/dev/null || true
  iptables -t nat -N PIX_POST 2>/dev/null || iptables -t nat -F PIX_POST
  iptables -t nat -C POSTROUTING -j PIX_POST 2>/dev/null || iptables -t nat -I POSTROUTING 1 -j PIX_POST
  if ts_on; then
    ip rule add priority 97 to $TS_NET lookup $TS_TABLE
    iptables -t nat -A PIX_POST -s $TS_NET -o wg0 -j MASQUERADE
    iptables -t nat -A PIX_POST -s $TS_NET -o wg2 -j MASQUERADE
  fi

  # routing: per-device rules (94) are checked before the default provider rule (95);
  # both before WARP's fixed rules (98/99), whatever order things started in
  while ip rule del priority 94 2>/dev/null; do :; done
  while ip rule del priority 95 2>/dev/null; do :; done

  # 1) per-device overrides first (most specific)
  while read -r ip mode; do
    [ -n "$ip" ] || continue
    mode=$(effective "$mode")
    case "$mode" in
      provider) ip rule add priority 94 from "$ip" iif wg1 lookup $PROVIDER_TABLE ;;
      warp)     ip rule add priority 94 from "$ip" iif wg1 lookup $WARP_FWMARK ;;
    esac
    # keep this device out of a default-mode Tor redirect
    [ "$mode" != tor ] && iptables -t nat -A PIX_NAT -i wg1 -s "$ip" -j RETURN
    _mode_rules "$mode" "-s $ip"
  done < <(overrides)

  # 2) everyone else follows the default
  [ "$default" = provider ] && ip rule add priority 95 iif wg1 lookup $PROVIDER_TABLE
  _mode_rules "$default" ""
  if ts_on; then   # 2b) devices away from home (Tailscale) follow the same default
    [ "$default" = provider ] && ip rule add priority 95 iif $TS_IF lookup $PROVIDER_TABLE
    _mode_rules "$default" "" "$TS_IF"
  fi

  # 2c) the gateway's own DNS-over-HTTPS goes through the provider while it carries devices
  #     (iif lo = only traffic the gateway itself creates); if the provider is down it falls back to WARP
  while ip rule del priority 91 2>/dev/null; do :; done
  if uses provider; then
    for d in $DOH_IPS; do ip rule add priority 91 to "$d" iif lo lookup $PROVIDER_TABLE; done
  fi

  # 3) Provider+Tor: Tor's own connections (its uid) use the provider table; if that tunnel is down
  #    they get "unreachable" instead of slipping out through WARP (fail closed)
  while ip rule del priority 92 2>/dev/null; do :; done
  while ip rule del priority 93 2>/dev/null; do :; done
  if [ "$(tor_via)" = provider ]; then
    local tuid; tuid=$(id -u debian-tor)
    ip rule add priority 92 uidrange "$tuid-$tuid" lookup $PROVIDER_TABLE
    ip rule add priority 93 uidrange "$tuid-$tuid" unreachable
  fi
}

adguard_api() { curl -sf -m 5 -u "$ADGUARD_USER:$ADGUARD_PASSWORD" "$@"; }

adguard_dns() {
  [ -n "${ADGUARD_USER:-}" ] && [ -n "${ADGUARD_PASSWORD:-}" ] || { log "AdGuard credentials not set: DNS upstream unchanged"; return 0; }
  local default=$1 up fb ip mode
  case "$default" in
    tor)      up="[\"$TOR_DNS\"]"; fb="[\"$TOR_DNS\"]" ;;
    provider) up=$PROVIDER_UPSTREAMS; fb=$PROVIDER_FALLBACK ;;
    *)        up=$WARP_UPSTREAMS; fb=$WARP_FALLBACK ;;
  esac
  # Full DNS config on purpose: a partial POST would reset DNSSEC, the anti-fingerprinting
  # blocked_hosts and the bootstrap resolvers. Bootstrap is Quad9-only (plain, but inside
  # the tunnel) so Cloudflare is not asked to resolve our resolver's own hostnames.
  local body
  body=$(printf '{"upstream_dns":%s,"fallback_dns":%s,"bootstrap_dns":["9.9.9.9","149.112.112.112"],"upstream_mode":"load_balance","protection_enabled":true,"blocking_mode":"default","blocked_response_ttl":10,"blocked_hosts":["version.bind","id.server","hostname.bind"],"dnssec":true,"ipv6_disabled":false,"local_ptr_upstreams":[],"use_private_ptr_resolvers":false}' "$up" "$fb")
  for _ in $(seq 1 30); do
    adguard_api -H 'Content-Type: application/json' -d "$body" \
      "$ADGUARD_URL/control/dns_config" >/dev/null && break
    sleep 2
  done || { log "AdGuard API unreachable: DNS upstream unchanged"; return 1; }
  # per-device DNS: a device in Tor mode resolves through Tor even when the default isn't Tor
  for ip in $(adguard_api "$ADGUARD_URL/control/clients" | python3 -c '
import sys, json
for c in (json.load(sys.stdin).get("clients") or []):
    if c.get("name", "").startswith("pgw-"): print(c["name"])' 2>/dev/null); do
    adguard_api -H 'Content-Type: application/json' -d "{\"name\":\"$ip\"}" "$ADGUARD_URL/control/clients/delete" >/dev/null
  done
  # a device whose exit differs from the default gets that exit's resolvers
  # (a WARP device under a provider/Tor default keeps the stricter default)
  local ups
  while read -r ip mode; do
    mode=$(effective "$mode")
    [ "$mode" != "$default" ] || continue
    case "$mode" in
      tor)      ups="[\"$TOR_DNS\"]" ;;
      provider) ups=$PROVIDER_UPSTREAMS ;;
      *)        continue ;;
    esac
    adguard_api -H 'Content-Type: application/json' "$ADGUARD_URL/control/clients/add" -d \
      "{\"name\":\"pgw-$ip\",\"ids\":[\"$ip\"],\"use_global_settings\":true,\"use_global_blocked_services\":true,\"upstreams\":$ups}" >/dev/null
  done < <(overrides)
  adguard_api -X POST "$ADGUARD_URL/control/cache_clear" >/dev/null
  return 0
}

tunnel_ready() {  # $1 = interface; brings it up if needed and checks it reaches the internet
  [ -f "$WG/$1.conf" ] || return 1
  ip link show "$1" >/dev/null 2>&1 || wg-quick up "$1" >/dev/null 2>&1
  for _ in $(seq 1 15); do
    curl -s -m 6 --interface "$1" https://1.1.1.1/cdn-cgi/trace | grep -q '^ip=' && return 0
    sleep 2
  done
  return 1
}

tor_ready() {   # $1 = attempts (default 45, ~2-7 min)
  for _ in $(seq 1 "${1:-45}"); do
    curl -s -m 8 --socks5-hostname 127.0.0.1:9050 https://check.torproject.org/api/ip | grep -q '"IsTor":true' && return 0
    sleep 2
  done
  return 1
}

apply() {   # $1 = --nowait: background loop - never stall it waiting for Tor or the provider
  local default nowait=${1:-}
  default=$(saved_mode)
  firewall   # first: the kill switch is never open while we wait for a tunnel
  if [ -z "$nowait" ]; then   # interactive switch: wait so the caller learns whether the exit works
    if uses tor && ! tor_ready; then log "Tor not ready - its devices stay blocked until it connects"; return 1; fi
    # with failover on, don't block here: the reconcile loop notices a dead provider within ~10 s
    if uses provider && [ "${EXIT_FAILOVER:-off}" != warp ] && ! tunnel_ready wg2; then
      log "$PROVIDER_NAME not reachable - its devices stay blocked until it connects"; return 1
    fi
  fi
  # a newer "pgw-exit set" may have run while we waited for Tor/the provider: it owns DNS now
  [ "$(saved_mode)" = "$default" ] || { log "exit mode changed to $(saved_mode) while waiting - leaving it"; return 0; }
  adguard_dns "$(effective "$default")"
  # DoH/DoT domain rules, Tor padding and (optionally) the read-only onion dashboard
  /usr/local/bin/pgw-anon apply >/dev/null 2>&1 || log "pgw-anon apply failed (anonymity rules incomplete)"
  { echo "$default"; overrides; cat /run/pgw/failover 2>/dev/null; } | md5sum | cut -c1-12 > /run/pgw/applied
  log "exit mode: $default$(overrides | awk '{printf " | %s=%s", $1, $2}')"
}

# fingerprint of what *should* be applied (reconcile compares it with /run/pgw/applied)
wanted() { { saved_mode; overrides; cat /run/pgw/failover 2>/dev/null; } | md5sum | cut -c1-12; }

case "${1:-status}" in
  status)   saved_mode ;;
  wanted)   wanted ;;
  configured) configured "${2:-}" ;;
  devices)  overrides ;;
  firewall) firewall ;;
  apply)    apply "${2:-}" ;;
  set)
    valid_mode "${2:-}" || { echo "usage: pgw-exit set warp|provider|tor" >&2; exit 2; }
    [ "$2" != provider ] || [ -f "$WG/wg2.conf" ] || { echo "no provider configured: put its WireGuard config at /config/provider.conf and restart" >&2; exit 2; }
    echo "$2" > "$MODE_FILE"; sync "$MODE_FILE"
    apply ;;
  device)
    ip=${2:-}; mode=${3:-}
    [[ $ip =~ ^${VPN_PREFIX//./\\.}\.[0-9]{1,3}$ ]] || { echo "usage: pgw-exit device <vpn-ip> warp|provider|tor|default" >&2; exit 2; }
    { valid_mode "$mode" || [ "$mode" = default ]; } || { echo "mode must be warp, provider, tor or default" >&2; exit 2; }
    [ "$mode" != provider ] || [ -f "$WG/wg2.conf" ] || { echo "no provider configured" >&2; exit 2; }
    touch "$DEV_FILE"; grep -v "^$ip " "$DEV_FILE" > "$DEV_FILE.new" || true
    [ "$mode" = default ] || echo "$ip $mode" >> "$DEV_FILE.new"
    mv "$DEV_FILE.new" "$DEV_FILE"; sync "$DEV_FILE"
    apply ;;
  tor-via)
    case "${2:-status}" in
      status) tor_via ;;
      warp|provider)
        [ "$2" != provider ] || [ -f "$WG/wg2.conf" ] || { echo "no provider configured" >&2; exit 2; }
        echo "$2" > "$TORVIA_FILE"; firewall
        pkill -TERM -x tor || true                  # supervisord starts it again on the new path
        if tor_ready 12; then log "Tor now reaches the internet via $2"
        elif [ "$2" = provider ]; then
          echo warp > "$TORVIA_FILE"; firewall; pkill -TERM -x tor || true
          log "Tor could not connect through $PROVIDER_NAME - back to WARP"; exit 1
        else log "Tor not connected yet (it keeps trying)"; fi ;;
      *) echo "usage: pgw-exit tor-via warp|provider|status" >&2; exit 2 ;;
    esac ;;
  tor-bridge)
    case "${2:-status}" in
      status) [ "$(cat "$BRIDGE_FILE" 2>/dev/null)" = snowflake ] && echo snowflake || echo off ;;
      off|snowflake)
        old=$(cat "$BRIDGE_FILE" 2>/dev/null || echo off)
        echo "$2" > "$BRIDGE_FILE"; make_torrc; chmod 644 "$CFG/tor/torrc"
        pkill -TERM -x tor || true                  # supervisord starts it again with the new config
        # Snowflake has to find a volunteer proxy first: allow ~6 min before giving up
        if tor_ready 36; then log "Tor bridge: $2"
        elif [ "$2" = snowflake ]; then
          echo "$old" > "$BRIDGE_FILE"; make_torrc; chmod 644 "$CFG/tor/torrc"; pkill -TERM -x tor || true
          log "Snowflake could not connect - back to the previous Tor connection"; exit 1
        else log "Tor not connected yet (it keeps trying)"; fi ;;
      *) echo "usage: pgw-exit tor-bridge snowflake|off|status" >&2; exit 2 ;;
    esac ;;
  *) echo "usage: pgw-exit status | set <mode> | device <ip> <mode|default> | devices | tor-via <warp|provider> | tor-bridge <snowflake|off> | apply | firewall" >&2; exit 2 ;;
esac
