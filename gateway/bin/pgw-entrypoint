#!/bin/bash
# Container start: create missing configs, arm the kill switch, bring the tunnels up,
# then hand over to supervisord (reconcile loop, Tor, dashboard).
set -uo pipefail
. /usr/local/bin/pgw-lib

# The container is NOT privileged (only NET_ADMIN + NET_RAW). Kernel settings and the WireGuard
# module are prepared once on the host by scripts/setup.sh; here we only check them.
sysctl -qw net.ipv4.ip_forward=1 net.ipv4.conf.all.src_valid_mark=1 2>/dev/null || true
for k in net.ipv4.ip_forward net.ipv4.conf.all.src_valid_mark; do
  [ "$(sysctl -n "$k" 2>/dev/null)" = 1 ] || { log "ERROR: $k is not 1 on the host - run scripts/setup.sh"; exit 1; }
done
ip link add pgw-probe type wireguard 2>/dev/null && ip link del pgw-probe || {
  log "ERROR: no WireGuard in the host kernel (needs Linux 5.6+; scripts/setup.sh loads the module)"; exit 1; }

mkdir -p "$WG" "$CFG/peers" "$CFG/warp" "$CFG/tor/data" /run/pgw /run/tor
chmod 700 "$WG" "$CFG/peers" "$CFG/warp"
# /config itself: traversable (not listable) so Tor, which runs as its own user, reaches /config/tor;
# everything secret below it is 0600/0700
chmod 711 "$CFG"; chmod 600 "$CFG"/provider.conf "$CFG"/history.db "$CFG"/device-modes 2>/dev/null || true
mkdir -p "$CFG/tor/onion"
chown -R debian-tor:debian-tor "$CFG/tor/data" "$CFG/tor/onion" /run/tor
chmod 700 "$CFG/tor/data" "$CFG/tor/onion" && chmod 755 "$CFG/tor"
umask 077

[ -f "$WG/wg1.conf" ] || make_server
[ -f "$WG/wg0.conf" ] || make_warp || { log "ERROR: WARP registration failed (no internet?)"; exit 1; }
if [ -f "$CFG/provider.conf" ]; then make_provider; else rm -f "$WG/wg2.conf"; fi
make_torrc && chmod 644 "$CFG/tor/torrc"   # no secrets; Tor runs as its own user
[ -f "$CFG/mode" ] || echo "${DEFAULT_MODE:-warp}" > "$CFG/mode"

# Kill switch BEFORE the VPN server comes up: devices can never leave unprotected.
# If it cannot be armed we must NOT start the VPN server at all (that would be an open gateway).
pgw-exit firewall || { log "ERROR: the kill switch could not be armed - refusing to start"; exit 1; }

# Interfaces live in the host's network namespace and survive container restarts,
# so always start from a clean slate. WARP first (the provider tunnel runs inside it).
for i in wg0 wg2 wg1; do
  [ -f "$WG/$i.conf" ] || continue
  wg-quick down "$i" >/dev/null 2>&1 || ip link del "$i" 2>/dev/null || true
  wg-quick up "$i" >/dev/null 2>&1 && log "$i up" || log "WARNING: $i failed to start - will retry"
done

log "VPN server ready on UDP $WG_PORT. Add a device: docker compose exec gateway pgw add-peer phone"
exec /usr/bin/supervisord -c /etc/supervisor/conf.d/pgw.conf
