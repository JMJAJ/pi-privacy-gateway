#cloud-config
# Pi Privacy Gateway - default first-boot settings, used when you flash WITHOUT Raspberry Pi Imager's
# setup screen. With the setup screen (recommended: your own user, password, Wi-Fi and SSH key), Imager
# replaces this file - that's fine, the gateway installer is part of the image itself.
hostname: pi-privacy-gateway
manage_etc_hosts: true
# Login: ubuntu / ubuntu, a new password is required at first login (same as Ubuntu's own image).
# SSH with password is on so you can log in from another computer.
ssh_pwauth: true
chpasswd:
  expire: true
  users:
    - name: ubuntu
      password: ubuntu
      type: text
# The gateway installs itself in the background after the first boot (pgw-firstboot.service: waits for the
# internet and retries every minute until done, ~15-20 min). Progress: /var/log/pgw-firstboot.log
final_message: "Pi Privacy Gateway: the install continues in the background - see /var/log/pgw-firstboot.log"
